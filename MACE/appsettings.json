{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft":                        "Warning",
        "Microsoft.AspNetCore":             "Warning",
        "Microsoft.Hosting.Lifetime":       "Information",
        "Grpc.AspNetCore":                  "Warning"
      }
    }
  },
  "Inference": {
    "NumSensorTypes":         7,
    "NumThreatLevels":        5,
    "PoolSize":               4,
    "MinSensorsForInference": 2,
    "PoolAcquireTimeoutMs":   5000
  },
  "AllowedHosts": "*"
}
