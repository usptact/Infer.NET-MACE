// MACE Inference Service — sample configuration
//
// How to use:
//   cp appsettings.sample.json appsettings.local.json
//   dotnet run --project MACE
//
// Load order (later files win):
//   appsettings.json  →  appsettings.{ASPNETCORE_ENVIRONMENT}.json  →  environment variables
//
// Environment variable override syntax (double-underscore as separator):
//   INFERENCE__POOLSIZE=8
//   INFERENCE__NUMSENSORTYPES=10
//   SERILOG__MINIMUMLEVEL__DEFAULT=Debug
//
// Ports (currently hardcoded in Program.cs):
//   :8080  gRPC service  (cleartext HTTP/2 — TLS terminated at the load balancer)
//   :9090  Prometheus metrics  (HTTP/1.1)

{
  // ── Inference engine ─────────────────────────────────────────────────────────
  "Inference": {

    // Number of distinct sensor modalities in your deployment.
    // This determines the width of the MACE annotation matrix (one column per
    // sensor type). Every Infer RPC call must supply an annotations array of
    // exactly this length (-1 for sensors not present in the incident).
    //
    // Default sensor-type index mapping (change to match your deployment):
    //   0 = CAMERA_CV        camera-based CV: person / weapon detection
    //   1 = MICROPHONE        acoustic: gunshot / glass-break audio
    //   2 = ACCESS_CONTROL    door forced / proximity sensor
    //   3 = DOOR_SENSOR       door open / closed / forced
    //   4 = GLASS_BREAK       glass-break detector
    //   5 = BADGE_READER      access-control badge events
    //   6 = TIME_CONTEXT      ambient risk based on time of day
    "NumSensorTypes": 7,

    // Number of discrete threat levels: 0 = CLEAR … (NumCategories-1) = CRITICAL.
    // The five-level scale below is recommended. Changing this value requires
    // resetting all sensor priors in the Belief Store (θ and φ distributions are
    // sensitive to the category count).
    //   0 = CLEAR      no detected threat
    //   1 = LOW        minor anomaly, monitor only
    //   2 = MEDIUM     elevated concern, flag for review
    //   3 = HIGH       strong evidence of threat, alert operator
    //   4 = CRITICAL   immediate response required
    // "NumCategories": 5,   // default

    // Number of MACETrain instances kept alive in the pool.
    // Each slot can serve one concurrent Infer RPC call.
    // Rule of thumb: set to the expected number of concurrently active incidents.
    // Requests queue (not rejected) when all slots are busy; they time out after
    // PoolAcquireTimeoutMs milliseconds.
    // Memory cost: roughly 100 MB per slot for the compiled Infer.NET factor graph.
    // First slot startup takes ~1–3 s (JIT + Roslyn compilation); subsequent slots
    // reuse the compiled code and start in tens of milliseconds.
    "PoolSize": 4,

    // Minimum number of distinct sensor types that must have reported before
    // running full VMP inference. Incidents below this count skip the Bayesian
    // model and return a raw-max-annotation fallback with a flat (uniform) t_dist
    // and confidence = 1/NumCategories.
    // Set to 1 to always run inference even with a single sensor, or higher to
    // require corroboration before committing to a threat score.
    // "MinSensorsForInference": 2,   // default

    // How long a queued Infer request waits for a free pool slot before the
    // server returns gRPC status UNAVAILABLE. Increase if incidents are long-lived
    // and the pool is frequently saturated. Decrease for stricter latency SLOs.
    // "PoolAcquireTimeoutMs": 5000   // default (5 seconds)
  },

  // ── Logging ──────────────────────────────────────────────────────────────────
  // Output template is defined in Program.cs:
  //   [yyyy-MM-dd HH:mm:ss.fff LVL] [ClassName] message
  //
  // Available levels (ascending severity):
  //   Verbose | Debug | Information | Warning | Error | Fatal
  //
  // Setting a level implicitly enables all levels above it.
  // Override entries silence noisy framework namespaces so application logs
  // are not buried under ASP.NET Core / gRPC infrastructure messages.
  "Serilog": {
    "MinimumLevel": {

      // Default level applied to every namespace not listed in Override.
      // Use "Information" for production. Use "Debug" locally to see full
      // request/response contents and Bayesian update detail.
      "Default": "Information",

      "Override": {
        // ASP.NET Core pipeline internals — noisy at Information in production.
        "Microsoft":                  "Warning",
        "Microsoft.AspNetCore":       "Warning",

        // Host startup / shutdown messages are useful — keep at Information.
        "Microsoft.Hosting.Lifetime": "Information",

        // gRPC framework messages (connection setup, keepalives, etc.).
        "Grpc.AspNetCore":            "Warning"
      }
    }
  }
}
