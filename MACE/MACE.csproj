<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>MACE - Multi-Annotator Competence Estimation</AssemblyTitle>
    <AssemblyDescription>Infer.NET implementation of the MACE algorithm for crowdsourcing annotation quality estimation</AssemblyDescription>
    <AssemblyCompany>Microsoft Research</AssemblyCompany>
    <AssemblyProduct>Infer.NET MACE</AssemblyProduct>
    <AssemblyCopyright>Copyright © Microsoft Corporation</AssemblyCopyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.Probabilistic" Version="0.4.2402.2904" />
    <PackageReference Include="Microsoft.ML.Probabilistic.Compiler" Version="0.4.2402.2904" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.65.0" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos/mace_inference.proto" GrpcServices="Server" />
  </ItemGroup>

</Project>