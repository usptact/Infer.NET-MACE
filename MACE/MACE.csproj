<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>MACE - Multi-Annotator Competence Estimation</AssemblyTitle>
    <AssemblyDescription>Infer.NET implementation of the MACE algorithm for crowdsourcing annotation quality estimation</AssemblyDescription>
    <AssemblyCompany>Microsoft Research</AssemblyCompany>
    <AssemblyProduct>Infer.NET MACE</AssemblyProduct>
    <AssemblyCopyright>Copyright © Microsoft Corporation</AssemblyCopyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.Probabilistic" Version="0.4.2402.2904" />
    <PackageReference Include="Microsoft.ML.Probabilistic.Compiler" Version="0.4.2402.2904" />
  </ItemGroup>

  <ItemGroup>
    <None Include="sample_data.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="true_labels.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>