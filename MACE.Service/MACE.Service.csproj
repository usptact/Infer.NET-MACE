<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>MACE Inference Service</AssemblyTitle>
    <AssemblyDescription>gRPC service serving MACE label inference and worker reliability feedback</AssemblyDescription>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>MACE.Service</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MACE\MACE.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\mace_inference.proto" GrpcServices="Server" />
  </ItemGroup>

</Project>
