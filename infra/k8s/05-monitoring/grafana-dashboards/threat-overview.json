{
  "__inputs": [],
  "__requires": [{ "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" }],
  "title": "ThreatSense – Threat Overview",
  "uid": "threatsense-threats",
  "tags": ["threatsense", "security"],
  "timezone": "browser",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Inference Pool Available",
      "description": "Idle pool slots. Sustained 0 = pool saturation.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{
        "expr": "mace_pool_available",
        "legendFormat": "slots"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green",  "value": 2 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Inference Requests / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{
        "expr": "sum by (status) (rate(mace_infer_requests_total[1m]))",
        "legendFormat": "{{status}}"
      }]
    },
    {
      "id": 3,
      "title": "Inference Latency P99 (ms)",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{
        "expr": "histogram_quantile(0.99, rate(mace_infer_duration_seconds_bucket[5m])) * 1000",
        "legendFormat": "P99 ms"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "red",    "value": 500 }
            ]
          },
          "max": 1000, "unit": "ms"
        }
      }
    },
    {
      "id": 4,
      "title": "UpdatePriors Requests / sec",
      "description": "Rate of Feedback Processor calls.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{
        "expr": "sum by (verdict) (rate(mace_update_priors_requests_total[1m]))",
        "legendFormat": "{{verdict}}"
      }]
    }
  ]
}
