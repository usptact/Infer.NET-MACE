{
  "__inputs": [],
  "__requires": [{ "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" }],
  "title": "ThreatSense – Threat Overview",
  "uid": "threatsense-threats",
  "tags": ["threatsense", "security"],
  "timezone": "browser",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Active Incidents by Zone",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{
        "expr": "count by (zone_id) (threatsense_incident_active{status='OPEN'})",
        "legendFormat": "{{zone_id}}"
      }]
    },
    {
      "id": 2,
      "title": "Threat Level Distribution (last 1h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{
        "expr": "sum by (threat_level) (rate(threatsense_threat_score_total[5m]))",
        "legendFormat": "{{threat_level}}"
      }]
    },
    {
      "id": 3,
      "title": "Inference Latency P99 (ms)",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{
        "expr": "histogram_quantile(0.99, rate(threatsense_inference_duration_seconds_bucket[5m])) * 1000",
        "legendFormat": "P99 ms"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "red", "value": 500 }
            ]
          },
          "max": 1000, "unit": "ms"
        }
      }
    },
    {
      "id": 4,
      "title": "Sensor Events / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{
        "expr": "sum by (sensor_type) (rate(threatsense_sensor_events_total[1m]))",
        "legendFormat": "{{sensor_type}}"
      }]
    }
  ]
}
